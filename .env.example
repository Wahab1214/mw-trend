# ==============================================================================
# MW TRENDS — PRODUCTION ENVIRONMENT CONFIGURATION
# Copy to .env.local for local development
# ==============================================================================

# NEXT.JS CORE
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME="MW Trends"
NEXT_PUBLIC_SITE_TAGLINE="Premium Print-on-Demand & Personalized Gifts in Pakistan"

# SUPABASE CONFIGURATION
# Obtain these from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# STORE DEFAULTS & CURRENCY
NEXT_PUBLIC_CURRENCY_CODE=PKR
NEXT_PUBLIC_CURRENCY_SYMBOL="Rs."
NEXT_PUBLIC_DEFAULT_SHIPPING_FEE=250
NEXT_PUBLIC_FREE_SHIPPING_THRESHOLD=3000
NEXT_PUBLIC_WHATSAPP_NUMBER="+923001234567"
NEXT_PUBLIC_SUPPORT_EMAIL="support@mwtrends.pk"

# PAYMENT GATEWAYS (PLUGGABLE ADAPTER PATTERN)
# COD and Manual Verification (JazzCash/Easypaisa/Bank) work natively out of the box.
# Automated gateways activate when credentials are provided:
ENABLE_JAZZ_CASH_GATEWAY=false
JAZZ_CASH_MERCHANT_ID=
JAZZ_CASH_PASSWORD=
JAZZ_CASH_INTEGRITY_SALT=

ENABLE_EASYPAISA_GATEWAY=false
EASYPAISA_STORE_ID=
EASYPAISA_HASH_KEY=

ENABLE_CARD_GATEWAY=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# EMAIL / NOTIFICATION SERVICE
# Used for order confirmation & admin order notifications
RESEND_API_KEY=
ADMIN_NOTIFICATION_EMAIL=orders@mwtrends.pk

# ANALYTICS & MARKETING (Consent-aware)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# FEATURE FLAGS
NEXT_PUBLIC_ENABLE_CUSTOMER_FILE_UPLOAD=false # Phase 2 toggle (default false)
NEXT_PUBLIC_ENABLE_URDU_LANGUAGE=false
